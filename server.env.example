# =========================================
# Firebase Admin para app inventario
# Usa UNA de estas dos opciones:
# 1) GOOGLE_APPLICATION_CREDENTIALS_JSON
# 2) FIREBASE_ADMIN_PROJECT_ID + FIREBASE_ADMIN_CLIENT_EMAIL + FIREBASE_ADMIN_PRIVATE_KEY
# =========================================

# Opcion 1: JSON completo en una sola variable
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Opcion 2: Variables separadas
FIREBASE_ADMIN_PROJECT_ID=inventario-sanmartin
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@inventario-sanmartin.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREEMPLAZAR\n-----END PRIVATE KEY-----\n

# =========================================
# MySQL de SICAR
# =========================================
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# =========================================
# Opcionales para funcion serverless / integracion
# =========================================
INTERNAL_API_TOKEN=
SICAR_API_URL=
SICAR_API_METHOD=POST
SICAR_API_TOKEN=
